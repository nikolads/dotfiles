[user]
    name = Nikola Stoyanov
    email = nikola.da.stoyanov@gmail.com

[alias]
    bn = rev-parse --abbrev-ref HEAD
    co = checkout
    lg = log --graph -n 20 --pretty=lg
    lo = log -n 1 --pretty=fuller

[color.decorate]
    head = cyan bold
    branch = cyan
    remoteBranch = magenta

[core]
    editor = kak

[diff]
    algorithm = histogram
    renames = true
    renamesLimit = 0

[fetch]
    prune = true

[init]
    defaultBranch = master

[pager]
    lg = git-log-fmt.py

[pretty]
    lg = %C(red)%h%C(reset) %C(green){{{age:%cr}}}%C(reset) %C(8 bold){{{email:%ae}}}%C(reset) - %s  %C(auto)%D%C(reset)

[pull]
    ff = only

[push]
    default = simple
